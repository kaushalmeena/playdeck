{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 80,
	"trailingComma": "all",
	"sortImports": true,
	"sortTailwindcss": {
		"stylesheet": "./src/styles.css",
		"functions": ["clsx"]
	},
	"ignorePatterns": [
		"src/routeTree.gen.ts",
		"public/vendor",
		"dist",
		".tanstack"
	]
}
